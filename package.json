{
  "name": "uipi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI harness over the pi coding agent SDK — multi-session, pi-parity config/extensions",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @uipi/server start",
    "check": "pnpm -r run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.10.0",
    "typescript-eslint": "^8.72.0"
  }
}
